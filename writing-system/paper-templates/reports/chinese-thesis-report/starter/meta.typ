// ------------------------------------------------------------
//  meta.typ — 文档元信息（唯一事实来源）
//
//  只放“这篇报告是什么”，不放任何排版代码。
//  main.typ 读取这里的值交给模板；content/ 里不放这些字段。
//  下面全部是**占位示例**，请逐项替换。
// ------------------------------------------------------------

#let meta = (
  title: [（示例）技术研究报告标题],
  title-en: [Example Technical Report Title],
  date: [二〇二六年九月],

  // 页眉文字。留 none 则自动用 title。
  header-title: [（示例）技术研究报告标题],

  keywords: [关键词一；关键词二；关键词三],
  keywords-en: [keyword one; keyword two; keyword three],

  // 封面信息栏：(标签, 内容) 数组，按顺序逐行渲染。
  cover-fields: (
    ([研究方向：], [（示例）请替换为你的研究方向]),
    ([报告类型：], [（示例）技术研究报告]),
  ),
)
